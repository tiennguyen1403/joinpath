# Copy to .env for local development. CI and the host set these directly.
DATABASE_URL=postgresql://joinpath:joinpath@localhost:5433/joinpath
# Origin of the web app; writes from any other Origin are refused (CSRF, PLAN §9).
APP_ORIGIN=http://localhost:3000
# Password of every user in the fixed demo org (pnpm db:seed). Use a secret in production.
SEED_PASSWORD=joinpath-local
# Proxies in front of the API, so req.ip is the client's (ADR 007). Unset = 0, fine locally.
# TRUST_PROXY_HOPS=1
# The private bucket for documents, on any S3-compatible service (PLAN §6.2). These match
# RustFS in docker-compose.yml; `pnpm storage:init` creates the bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=joinpath
S3_ACCESS_KEY_ID=joinpath
S3_SECRET_ACCESS_KEY=joinpath-local
