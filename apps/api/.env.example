# Copy to .env for local development. CI and the host set these directly.
DATABASE_URL=postgresql://joinpath:joinpath@localhost:5433/joinpath
# Origin of the web app; writes from any other Origin are refused (CSRF, PLAN §9).
APP_ORIGIN=http://localhost:3000
# Password of every user in the fixed demo org (pnpm db:seed). Use a secret in production.
SEED_PASSWORD=joinpath-local
