// Data model: PLAN §7. Tables and columns are snake_case; every FK cascades so a
// sandbox purge is one DELETE on organizations. Ids are UUIDv7 from Postgres 18.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // Partial unique indexes (@@unique with `where`) in the schema instead of hand-written SQL.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  /// Email domain of the org's people: @{slug}.joinpath.demo (BR-D04).
  slug            String    @unique
  timezone        String
  isSandbox       Boolean   @map("is_sandbox")
  clockOffsetDays Int       @default(0) @map("clock_offset_days")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  createdIpHash   String?   @map("created_ip_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  departments      Department[]
  employees        Employee[]
  users            User[]
  templates        Template[]
  templateVersions TemplateVersion[]
  auditEvents      AuditEvent[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name")
  email          String
  jobTitle       String   @map("job_title")
  departmentId   String?  @map("department_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  manager      Employee?    @relation("Reports", fields: [managerId], references: [id], onDelete: Cascade)
  reports      Employee[]   @relation("Reports")
  user         User?

  @@unique([organizationId, email])
  @@map("employees")
}

enum Role {
  HR
  IT
  MEMBER

  @@map("role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

model User {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  employeeId     String     @unique @map("employee_id") @db.Uuid
  /// Unique across all orgs, so the login form needs no org (PLAN §7, BR-D04).
  email          String     @unique
  role           Role
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions     Session[]
  auditEvents  AuditEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored (PLAN §9).
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Template {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String    @default("")
  /// Archiving is final: no more versions or edits, and no new onboardings (BR-T12).
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]

  @@map("templates")
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED

  @@map("template_version_status")
}

model TemplateVersion {
  id             String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  templateId     String                @map("template_id") @db.Uuid
  version        Int
  status         TemplateVersionStatus @default(DRAFT)
  /// TemplateDefinition as templateDefinitionSchema.parse() returns it (PLAN §4.2).
  definition     Json
  publishedAt    DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  // BR-T02: at most one draft per template. The client offers templateId alone as a
  // findUnique key, but it is unique among drafts only: never look a version up by it.
  @@unique([templateId], map: "template_versions_one_draft", where: { status: "DRAFT" })
  @@map("template_versions")
}

/// Append-only (PLAN §7): the audit trail and, from M1.4, the onboarding timeline.
model AuditEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Null when the system acted (seed, cron).
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  data           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@map("audit_events")
}
