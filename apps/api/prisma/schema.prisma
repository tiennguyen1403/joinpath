// Data model: PLAN §7. Tables and columns are snake_case; every FK cascades so a
// sandbox purge is one DELETE on organizations. Ids are UUIDv7 from Postgres 18.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // Partial unique indexes (@@unique with `where`) in the schema instead of hand-written SQL.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  /// Email domain of the org's people: @{slug}.joinpath.demo (BR-D04).
  slug            String    @unique
  timezone        String
  isSandbox       Boolean   @map("is_sandbox")
  clockOffsetDays Int       @default(0) @map("clock_offset_days")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  createdIpHash   String?   @map("created_ip_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  departments      Department[]
  employees        Employee[]
  users            User[]
  templates        Template[]
  templateVersions TemplateVersion[]
  onboardings      Onboarding[]
  tasks            Task[]
  taskDependencies TaskDependency[]
  invitations      Invitation[]
  mockEmails       MockEmail[]
  auditEvents      AuditEvent[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name")
  email          String
  jobTitle       String   @map("job_title")
  departmentId   String?  @map("department_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  manager       Employee?    @relation("Reports", fields: [managerId], references: [id], onDelete: Cascade)
  reports       Employee[]   @relation("Reports")
  user          User?
  onboardings   Onboarding[]
  assignedTasks Task[]

  @@unique([organizationId, email])
  @@map("employees")
}

enum Role {
  HR
  IT
  MEMBER

  @@map("role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

model User {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  employeeId     String     @unique @map("employee_id") @db.Uuid
  /// Unique across all orgs, so the login form needs no org (PLAN §7, BR-D04).
  email          String     @unique
  role           Role
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions     Session[]
  auditEvents  AuditEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored (PLAN §9).
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Template {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String    @default("")
  /// Archiving is final: no more versions or edits, and no new onboardings (BR-T12).
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]
  onboardings  Onboarding[]

  @@map("templates")
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED

  @@map("template_version_status")
}

model TemplateVersion {
  id             String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  templateId     String                @map("template_id") @db.Uuid
  version        Int
  status         TemplateVersionStatus @default(DRAFT)
  /// TemplateDefinition as templateDefinitionSchema.parse() returns it (PLAN §4.2).
  definition     Json
  publishedAt    DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  onboardings  Onboarding[]

  @@unique([templateId, version])
  // BR-T02: at most one draft per template. The client offers templateId alone as a
  // findUnique key, but it is unique among drafts only: never look a version up by it.
  @@unique([templateId], map: "template_versions_one_draft", where: { status: "DRAFT" })
  @@map("template_versions")
}

enum OnboardingStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED

  @@map("onboarding_status")
}

/// One employee's onboarding (PLAN §4.3). Its tasks exist from activation on.
model Onboarding {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  templateId        String           @map("template_id") @db.Uuid
  /// The version activation copied the tasks from (BR-A03); null while a draft.
  templateVersionId String?          @map("template_version_id") @db.Uuid
  status            OnboardingStatus @default(DRAFT)
  startDate         DateTime         @map("start_date") @db.Date
  activatedAt       DateTime?        @map("activated_at") @db.Timestamptz(3)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(3)
  canceledAt        DateTime?        @map("canceled_at") @db.Timestamptz(3)
  cancelReason      String?          @map("cancel_reason")
  /// Every command on its tasks bumps this first, which locks the row (PLAN §6.4).
  version           Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template        Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  tasks           Task[]
  invitations     Invitation[]
  auditEvents     AuditEvent[]

  // BR-A01: one open onboarding per employee. As with template drafts, the client offers
  // employeeId alone as a findUnique key, but it is unique among open onboardings only.
  // The predicate is spelled as Postgres stores `status IN ('DRAFT', 'ACTIVE')`; any other
  // spelling makes migrate diff see drift.
  @@unique([employeeId], map: "onboardings_one_open", where: raw("status = ANY (ARRAY['DRAFT'::onboarding_status, 'ACTIVE'::onboarding_status])"))
  @@map("onboardings")
}

enum TaskType {
  CHECKLIST
  DOCUMENT
  APPROVAL

  @@map("task_type")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED

  @@map("task_status")
}

/// A template task copied on activation, so later template changes never reach it (BR-A08).
/// Availability is worked out when read (PLAN §4.4). The migration adds
/// CHECK (available_on <= due_on).
model Task {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  onboardingId       String     @map("onboarding_id") @db.Uuid
  definitionKey      String     @map("definition_key")
  phaseKey           String     @map("phase_key")
  phaseName          String     @map("phase_name")
  phaseOrder         Int        @map("phase_order")
  /// Index in the template's task list, which orders the tasks within a phase.
  position           Int
  title              String
  description        String?
  type               TaskType
  assigneeEmployeeId String     @map("assignee_employee_id") @db.Uuid
  /// APPROVAL only: the DOCUMENT it reviews.
  reviewsTaskId      String?    @map("reviews_task_id") @db.Uuid
  availableOn        DateTime   @map("available_on") @db.Date
  dueOn              DateTime   @map("due_on") @db.Date
  /// HR set the due date by hand (BR-S03).
  dueOverridden      Boolean    @default(false) @map("due_overridden")
  status             TaskStatus @default(PENDING)
  startedAt          DateTime?  @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding   Onboarding       @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  assignee     Employee         @relation(fields: [assigneeEmployeeId], references: [id], onDelete: Cascade)
  reviews      Task?            @relation("Reviews", fields: [reviewsTaskId], references: [id], onDelete: Cascade)
  reviewedBy   Task[]           @relation("Reviews")
  dependsOn    TaskDependency[] @relation("Dependent")
  dependents   TaskDependency[] @relation("Prerequisite")

  @@unique([onboardingId, definitionKey])
  @@map("tasks")
}

/// The task waits for depends_on_task (ALL, BR-E02). The migration adds
/// CHECK (task_id <> depends_on_task_id).
model TaskDependency {
  organizationId  String   @map("organization_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task         @relation("Prerequisite", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

/// Lets a new hire with no account set a password (BR-A07, BR-P05). Activation sends one, and
/// HR's resend replaces it. The new hire is the onboarding's employee.
model Invitation {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  onboardingId   String    @map("onboarding_id") @db.Uuid
  /// The new hire's email when it was sent. Changing that email revokes it.
  email          String
  /// SHA-256 of the token: the token itself travels only in the email's link (PLAN §9).
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// By a resend, or by a change of the new hire's email.
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding   Onboarding   @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

/// What Joinpath would email. Nothing leaves the app: the mock inbox shows it all (PLAN §6.5).
/// With real email, a status column turns this table into an outbox.
model MockEmail {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  toEmail        String   @map("to_email")
  toName         String   @map("to_name")
  subject        String
  /// Plain text, a blank line between paragraphs.
  body           String
  /// The button under the text.
  link           String
  linkLabel      String   @map("link_label")
  /// Plain text under the button, like body: the small print.
  footer         String   @default("")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("mock_emails")
}

/// Append-only (PLAN §7): the audit trail and the onboarding timeline.
model AuditEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Null when the system acted (seed, cron).
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  /// Puts the event on this onboarding's timeline.
  onboardingId   String?  @map("onboarding_id") @db.Uuid
  data           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  onboarding   Onboarding?  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@map("audit_events")
}
