// Data model: PLAN §7. Tables and columns are snake_case; every FK cascades so a
// sandbox purge is one DELETE on organizations. Ids are UUIDv7 from Postgres 18.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  /// Email domain of the org's people: @{slug}.joinpath.demo (BR-D04).
  slug            String    @unique
  timezone        String
  isSandbox       Boolean   @map("is_sandbox")
  clockOffsetDays Int       @default(0) @map("clock_offset_days")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  createdIpHash   String?   @map("created_ip_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  departments Department[]
  employees   Employee[]
  users       User[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name")
  email          String
  jobTitle       String   @map("job_title")
  departmentId   String?  @map("department_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  manager      Employee?    @relation("Reports", fields: [managerId], references: [id], onDelete: Cascade)
  reports      Employee[]   @relation("Reports")
  user         User?

  @@unique([organizationId, email])
  @@map("employees")
}

enum Role {
  HR
  IT
  MEMBER

  @@map("role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

model User {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  employeeId     String     @unique @map("employee_id") @db.Uuid
  /// Unique across all orgs, so the login form needs no org (PLAN §7, BR-D04).
  email          String     @unique
  role           Role
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored (PLAN §9).
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
