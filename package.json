{
  "name": "joinpath",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @joinpath/core build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10"
  }
}
